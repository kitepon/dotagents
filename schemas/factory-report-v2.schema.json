{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitepon.dev/schemas/dotagents/factory-report-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "host_id", "host_profile", "platform", "report_mode", "observed_at", "created_at", "reporter", "products"],
  "properties": {"schema_version":{"const":"2.0"},"report_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"host_id":{"$ref":"#/$defs/stableId"},"host_profile":{"enum":["server","mac","linux","wsl","windows-native"]},"platform":{"type":"object","additionalProperties":false,"required":["os","arch"],"properties":{"os":{"enum":["darwin","linux","windows"]},"arch":{"enum":["x64","arm64","arm","ia32"]}}},"report_mode":{"const":"full"},"observed_at":{"$ref":"#/$defs/timestamp"},"created_at":{"$ref":"#/$defs/timestamp"},"reporter":{"type":"object","additionalProperties":false,"required":["version","dotagents_revision"],"properties":{"version":{"$ref":"#/$defs/version"},"dotagents_revision":{"type":"string","pattern":"^[0-9a-f]{7,64}$"}}},"products":{"type":"object","additionalProperties":false,"required":["caveat","throughline","spotter","codegraph","markitdown","gpt-connector","aiterm-mcp","codex-sidecar","servermanager","claude-code","codex-cli","grok-build"],"properties":{"caveat":{"$ref":"#/$defs/product"},"throughline":{"$ref":"#/$defs/product"},"spotter":{"$ref":"#/$defs/product"},"codegraph":{"$ref":"#/$defs/product"},"markitdown":{"$ref":"#/$defs/product"},"gpt-connector":{"$ref":"#/$defs/product"},"aiterm-mcp":{"$ref":"#/$defs/product"},"codex-sidecar":{"$ref":"#/$defs/product"},"servermanager":{"$ref":"#/$defs/product"},"claude-code":{"$ref":"#/$defs/product"},"codex-cli":{"$ref":"#/$defs/product"},"grok-build":{"$ref":"#/$defs/product"}}}},
  "$defs": {
    "stableId": {"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type":"string","minLength":1,"maxLength":128},
    "timestamp": {"type":"string","format":"date-time","pattern":"Z$"},
    "fingerprint": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "messageTemplate": {"type":"string","minLength":1,"maxLength":1024},
    "safeContext": {"type":"object","maxProperties":16,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,31}$"},"additionalProperties":{"oneOf":[{"type":"string","maxLength":256},{"type":"number"},{"type":"boolean"}]}},
    "check": {"type":"object","additionalProperties":false,"required":["check_id","status"],"properties":{"check_id":{"$ref":"#/$defs/stableId"},"status":{"enum":["pass","fail","unsupported","unverified","skipped"]},"severity":{"enum":["fatal","high","warn","info"]},"fingerprint":{"$ref":"#/$defs/fingerprint"},"message_template":{"$ref":"#/$defs/messageTemplate"},"occurrence_count":{"type":"integer","minimum":1},"first_seen":{"$ref":"#/$defs/timestamp"},"last_seen":{"$ref":"#/$defs/timestamp"},"reason_code":{"$ref":"#/$defs/stableId"},"safe_context":{"$ref":"#/$defs/safeContext"}},"allOf":[{"if":{"properties":{"status":{"const":"fail"}},"required":["status"]},"then":{"required":["severity","fingerprint","message_template","occurrence_count","first_seen","last_seen"]},"else":{"not":{"anyOf":[{"required":["severity"]},{"required":["fingerprint"]},{"required":["message_template"]},{"required":["occurrence_count"]},{"required":["first_seen"]},{"required":["last_seen"]}]}}},{"if":{"properties":{"status":{"const":"skipped"}},"required":["status"]},"then":{"required":["reason_code"]}}]},
    "runtimeError": {"type":"object","additionalProperties":false,"required":["error_code","component","status","severity","fingerprint","message_template","occurrence_count","first_seen","last_seen"],"properties":{"error_code":{"type":"string","minLength":3,"maxLength":96,"pattern":"^[A-Z][A-Z0-9_]*(?:\\.[A-Z0-9_]+)*$"},"component":{"$ref":"#/$defs/stableId"},"status":{"enum":["open","resolved"]},"severity":{"enum":["fatal","high","warn","info"]},"fingerprint":{"$ref":"#/$defs/fingerprint"},"message_template":{"$ref":"#/$defs/messageTemplate"},"occurrence_count":{"type":"integer","minimum":1},"first_seen":{"$ref":"#/$defs/timestamp"},"last_seen":{"$ref":"#/$defs/timestamp"},"state_schema_version":{"$ref":"#/$defs/version"},"safe_context":{"$ref":"#/$defs/safeContext"}}},
    "resolution": {"type":"object","additionalProperties":false,"required":["fingerprint","resolved_at","reason_code"],"properties":{"fingerprint":{"$ref":"#/$defs/fingerprint"},"resolved_at":{"$ref":"#/$defs/timestamp"},"reason_code":{"$ref":"#/$defs/stableId"}}},
    "product": {"type":"object","additionalProperties":false,"required":["presence_status","contract_version","checks","runtime_errors","resolutions"],"properties":{"presence_status":{"enum":["installed","missing","not_applicable","unverified"]},"installed_version":{"$ref":"#/$defs/version"},"latest_version":{"$ref":"#/$defs/version"},"source_revision":{"type":"string","pattern":"^[0-9a-f]{7,64}$"},"contract_version":{"$ref":"#/$defs/version"},"state_schema_version":{"$ref":"#/$defs/version"},"migration_status":{"enum":["not_applicable","current","pending","failed","unverified"]},"update_status":{"enum":["current","outdated","failed","unsupported","unverified"]},"compatibility_status":{"enum":["compatible","incompatible","unsupported","unverified"]},"checks":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/check"}},"runtime_errors":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/runtimeError"}},"resolutions":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/resolution"}}},"allOf":[{"if":{"properties":{"presence_status":{"const":"installed"}},"required":["presence_status"]},"then":{"properties":{"installed_version":{"$ref":"#/$defs/version"}},"required":["installed_version"]}}]}
  }
}
