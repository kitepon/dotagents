{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "${HOME}/.local/bin/cursor-git-destroy-gate-hook",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "${HOME}/.local/bin/cursor-constitution-hook",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "${HOME}/.local/bin/cursor-constitution-hook",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "${HOME}/.local/bin/cursor-constitution-hook",
        "timeout": 10
      }
    ]
  }
}
