# Git Bash でも shell 契約を壊さないよう、実行スクリプトは常に LF で checkout する。
*.sh text eol=lf

# 共通憲法の生成物はrendererがLF byte列を正本として照合する。
claude/CLAUDE.md text eol=lf
codex/AGENTS.md text eol=lf
grok/AGENTS.md text eol=lf
cursor/AGENTS.md text eol=lf
cursor/rules/factory.mdc text eol=lf
docs/factory-current-state.md text eol=lf
claude/skills/orchestrate/references/shared-orchestrate/** text eol=lf
codex/skills/orchestrate/references/shared-orchestrate/** text eol=lf
grok/skills/orchestrate/references/shared-orchestrate/** text eol=lf
cursor/skills/orchestrate/references/shared-orchestrate/** text eol=lf

# Lattice storeはcanonical JSON+LFのバイト列契約。EOL変換されると
# artifact_truncated_or_trailing_bytesでstore全体がfail closedする（Windows checkoutで実害）。
.lattice/** -text
