{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "${HOME}/.local/bin/cursor-git-destroy-gate-hook",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "${HOME}/.local/bin/cursor-delegation-gate-hook",
        "matcher": "Task",
        "timeout": 5
      }
    ],
    "subagentStart": [
      {
        "command": "${HOME}/.local/bin/cursor-delegation-gate-hook",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": "${HOME}/.local/bin/cursor-todo-gate-hook session-start",
        "timeout": 10
      },
      {
        "command": "${HOME}/.local/bin/cursor-lattice-gantt-hook session-start",
        "timeout": 5
      },
      {
        "command": "${HOME}/.local/bin/cursor-orchestrate-advisory-hook",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "${HOME}/.local/bin/cursor-todo-gate-hook stop",
        "timeout": 10
      }
    ]
  }
}
