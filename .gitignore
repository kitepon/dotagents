.DS_Store
*.swp
*.swo
*~
/node_modules/

# Python 実行時生成物（lib/orchestrate/hook_state.py 等を import した端末で発生）
__pycache__/
*.pyc

# per-machine state (Claude Code project-scoped settings, VSCode tasks with
# absolute paths baked in by Throughline). See README "含めないもの".
.claude/
.vscode/

# Throughline / Codex が生成する project-local state。dotagents の管理対象外。
/.agents/

# Spotter project marker / host別catalog / hook event は端末・host固有。
# 正規生成入口は各projectでの `spotter install -y`。
.spotter/

# codex-sidecar の作業物（隔離 worktree の App Server ログ等）は端末ローカル
.codex-sidecar/

# Obsidian vault config is per-machine (view state, workspace). The brain is
# the markdown itself; the viewer's settings stay local. See PLAN.md 原則7.
.obsidian/
.lattice/generated/
.lattice/runs/

# Lattice同梱sensorのproject-local index（生成・再構築可能）
.codegraph/
