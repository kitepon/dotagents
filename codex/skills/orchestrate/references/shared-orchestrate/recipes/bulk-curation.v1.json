{
  "schema": "dotagents.recipe.bulk-curation.v1",
  "phases": ["Apply"],
  "limits": {
    "targets_min": 1,
    "same_repo_writer_parallelism_without_lattice": 1
  },
  "io": {
    "target": {
      "type": "object",
      "required": ["target", "repo_root", "effect", "write_scope"],
      "properties": {
        "target": { "type": "string" },
        "repo_root": { "type": ["string", "null"] },
        "effect": { "type": "string", "enum": ["read", "write"] },
        "write_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "report": {
      "type": "object",
      "required": ["target", "fixed", "flags_for_owner"],
      "properties": {
        "target": { "type": "string" },
        "fixed": { "type": "array", "items": { "type": "string" } },
        "flags_for_owner": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "why"],
            "properties": {
              "file": { "type": "string" },
              "why": { "type": "string" },
              "quote": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "fixture": {
    "target": { "target": "claude/skills/foo", "repo_root": "/Users/kite/Developer/dotagents", "effect": "write", "write_scope": ["claude/skills/foo"] },
    "report": { "target": "claude/skills/foo", "fixed": ["frontmatter の description を起動条件文へ修正"], "flags_for_owner": [{ "file": "claude/skills/foo/SKILL.md", "why": "本文の例が現行 CLI と食い違う。意図不明のため裁定要", "quote": "`foo --legacy`" }] }
  }
}
